# Copy this file to .env and fill in the secrets; .env holds credentials and must never be committed.
# Compose passes this file to every application container, so it holds only application settings plus the compose interpolation variable at the end.
# The application validates the RAPIDWIRE_ variables at startup and rejects unknown RAPIDWIRE_ names, so compose-only variables carry no prefix.
# A command exits with an error when a value it needs is missing or invalid.
# Compose also reads RAPIDWIRE_DB_NAME, RAPIDWIRE_DB_USER and RAPIDWIRE_DB_PASSWORD to create the database and its user in the mysql service.
# The MySQL root password lives in .env.mysql and the tunnel token in .env.cloudflared instead; see .env.mysql.example and .env.cloudflared.example.
# Numeric settings other than the operator IDs must be positive integers unless noted otherwise.

# Database host name, non-empty; the default is the mysql service on the compose network (default mysql).
RAPIDWIRE_DB_HOST=mysql
# Database TCP port inside the compose network, 1-65535 (default 3306).
RAPIDWIRE_DB_PORT=3306
# Database schema name, 1-64 ASCII letters, digits or "_", not only digits; compose also uses it to create the schema on first start (default rapidwire).
RAPIDWIRE_DB_NAME=rapidwire
# Database user the application connects as, non-empty; compose also creates it on first start (default rapidwire).
RAPIDWIRE_DB_USER=rapidwire
# Password of the application database user, at least 8 characters and not blank (required, no default).
RAPIDWIRE_DB_PASSWORD=change-me-db-password

# Discord bot token, at least 8 characters (required by the bot and worker commands, no default; an empty value counts as unset).
RAPIDWIRE_DISCORD_TOKEN=
# Comma-separated Discord user IDs allowed to list and download backups through the API, each unique and between 1 and 2**63-1 (default empty, meaning nobody).
RAPIDWIRE_OPERATOR_ACCOUNT_IDS=

# Currency ID that pays contract gas, between 1 and 2**63-1 (default 1269970084965912747, RAPID).
RAPIDWIRE_GAS_CURRENCY_ID=1269970084965912747
# Price of one gas unit in minimal units of the gas currency (default 1).
RAPIDWIRE_GAS_PRICE=1
# Gas limit used when a contract call does not specify one (default 128).
RAPIDWIRE_DEFAULT_GAS=128
# Highest gas limit a contract call may request; at least RAPIDWIRE_DEFAULT_GAS and at most 500000 (default 200000).
RAPIDWIRE_MAX_GAS=200000
# Maximum size in bytes of a registered contract binary, between 1 and 8000 (default 8000).
RAPIDWIRE_CONTRACT_MAX_SIZE=8000

# Number of chunks a swap amount is split into for route allocation (default 100).
RAPIDWIRE_SWAP_CHUNK_COUNT=100
# Maximum number of candidate routes considered for one swap (default 32).
RAPIDWIRE_SWAP_MAX_ROUTES=32

# Seconds between periodic staking reward accruals run by the worker (default 1800).
RAPIDWIRE_STAKE_ACCRUAL_INTERVAL_SECONDS=1800
# Seconds since the last accrual after which staking accrual is treated as stale; must be at least RAPIDWIRE_STAKE_ACCRUAL_INTERVAL_SECONDS (default 10800).
RAPIDWIRE_STAKE_ACCRUAL_STALENESS_SECONDS=10800
# Seconds between outbox polls by the worker's dispatcher, as a positive decimal number (default 2.0).
RAPIDWIRE_OUTBOX_POLL_INTERVAL_SECONDS=2.0

# Seconds after the bot's last guild directory heartbeat at which the API and the worker stop trusting the guild information the bot wrote to the database, so currency management and contract has_role() fail closed while the bot is down.
# The bot writes a heartbeat every 30 seconds, so this must be at least 60, twice that interval (default 120).
RAPIDWIRE_GUILD_DIRECTORY_STALENESS_SECONDS=120

# Absolute directory inside the container where backups are written; compose mounts the backups volume at the default path, so keep the default there (default /var/lib/rapidwire/backups).
RAPIDWIRE_BACKUP_DIR=/var/lib/rapidwire/backups
# Number of backup generations kept; older ones are deleted first (default 14).
RAPIDWIRE_BACKUP_RETENTION=14
# Seconds between periodic backups taken by the worker; must be at least 60 (default 86400).
RAPIDWIRE_BACKUP_INTERVAL_SECONDS=86400

# Address the HTTP API binds to inside the container (default 0.0.0.0).
RAPIDWIRE_API_HOST=0.0.0.0
# Port the HTTP API listens on inside the container, 1-65535; cloudflared reaches it on the compose network (default 8000).
RAPIDWIRE_API_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR or CRITICAL, case-insensitive (default INFO).
RAPIDWIRE_LOG_LEVEL=INFO

# Compose interpolation only, not read by the application.
# Host port on 127.0.0.1 where MySQL is published for SSH port forwarding (default 3306).
MYSQL_HOST_PORT=3306
