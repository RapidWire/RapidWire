"""Type declarations of the RapidWire contract language for editors and type checkers.

A contract starts with `from rapidwire_contract import *`; `rwc stub DIR` writes this file into DIR so the import resolves next to the sources.
The compiler accepts exactly the names declared here, plus the Python builtins int(), str(), bool(), len() and range(), and the str and dict methods named "str.*" and "dict.*" in the builtin registry (rapidwire.contract.builtins).
"""

from collections.abc import Callable, Sequence
from typing import Any, NoReturn, TypeAlias, TypeVar, overload

_F = TypeVar("_F", bound=Callable[..., Any])
_T = TypeVar("_T")

class Account:
    """An account ID; equal only to an Account with the same ID."""

    def __init__(self, id: int) -> None: ...
    def __int__(self) -> int: ...

class Currency:
    """A currency ID; equal only to a Currency with the same ID."""

    def __init__(self, id: int) -> None: ...
    def __int__(self) -> int: ...

Value: TypeAlias = Any
"""A dynamic value; narrow it with int(), str(), bool() or an annotated assignment."""

_Scalar: TypeAlias = int | str | bool | Account | Currency

class Paid:
    @property
    def currency(self) -> Currency: ...
    @property
    def amount(self) -> int: ...

class CurrencyInfo:
    @property
    def currency(self) -> Currency: ...
    @property
    def name(self) -> str: ...
    @property
    def symbol(self) -> str: ...
    @property
    def issuer(self) -> Account: ...
    @property
    def supply(self) -> int: ...
    @property
    def hourly_rate_ppm(self) -> int: ...
    @property
    def minting_renounced(self) -> bool: ...
    @property
    def delegation_enabled(self) -> bool: ...
    @property
    def delete_requested(self) -> bool: ...
    @property
    def created_at(self) -> int: ...

class ClaimInfo:
    @property
    def claim_id(self) -> int: ...
    @property
    def claimant(self) -> Account: ...
    @property
    def payer(self) -> Account: ...
    @property
    def currency(self) -> Currency: ...
    @property
    def amount(self) -> int: ...
    @property
    def description(self) -> str: ...
    @property
    def status(self) -> str: ...
    @property
    def created_at(self) -> int: ...

class Quote:
    @property
    def from_currency(self) -> Currency: ...
    @property
    def to_currency(self) -> Currency: ...
    @property
    def amount_in(self) -> int: ...
    @property
    def amount_out(self) -> int: ...
    @property
    def route_count(self) -> int: ...
    @property
    def truncated(self) -> bool: ...

class CallResult:
    @property
    def ok(self) -> bool: ...
    @property
    def value(self) -> Value: ...
    @property
    def error(self) -> str: ...
    @property
    def message(self) -> str: ...

def public(fn: _F) -> _F: ...
def revert(message: str) -> NoReturn: ...
def call(target: Account, function: str, args: Sequence[_Scalar] = ..., *, attach: tuple[Currency, int] = ..., gas: int = ...) -> Value: ...
def try_call(target: Account, function: str, args: Sequence[_Scalar] = ..., *, attach: tuple[Currency, int] = ..., gas: int = ...) -> CallResult: ...

sender: Account
self: Account
paid: Paid

def now() -> int: ...
def balance(account: Account, currency: Currency) -> int: ...
def currency(symbol: str) -> Currency: ...
def currency_info(currency: Currency) -> CurrencyInfo: ...
def transfer(to: Account, currency: Currency, amount: int) -> None: ...
def transfer_from(owner: Account, to: Account, currency: Currency, amount: int) -> None: ...
def approve(spender: Account, currency: Currency, amount: int) -> None: ...
def allowance(owner: Account, spender: Account, currency: Currency) -> int: ...
def create_claim(payer: Account, currency: Currency, amount: int, description: str) -> int: ...
def pay_claim(claim_id: int) -> None: ...
def cancel_claim(claim_id: int) -> None: ...
def claim_info(claim_id: int) -> ClaimInfo: ...
def swap(from_currency: Currency, to_currency: Currency, amount_in: int, min_out: int) -> int: ...
def add_liquidity(currency_x: Currency, currency_y: Currency, fee_bps: int, amount_x: int, amount_y: int, amount_x_min: int, amount_y_min: int, min_shares: int) -> int: ...
def remove_liquidity(currency_x: Currency, currency_y: Currency, fee_bps: int, shares: int, amount_x_min: int, amount_y_min: int) -> list[int]: ...
def quote(from_currency: Currency, to_currency: Currency, amount_in: int) -> Quote: ...
def stake(currency: Currency, amount: int) -> None: ...
def unstake(currency: Currency, amount: int) -> None: ...
def staked(account: Account, currency: Currency) -> int: ...

class _Storage:
    @overload
    def get(self, key: str) -> Value: ...
    @overload
    def get(self, key: str, default: _T) -> _T: ...
    def set(self, key: str, value: Value) -> None: ...
    def delete(self, key: str) -> None: ...
    def __setitem__(self, key: str, value: Value) -> None: ...
    def __delitem__(self, key: str) -> None: ...

storage: _Storage

@overload
def read_storage(account: Account, key: str) -> Value: ...
@overload
def read_storage(account: Account, key: str, default: _T) -> _T: ...

class _Discord:
    def send(self, guild: int, channel: int, message: str) -> None: ...
    def add_role(self, guild: int, user: Account, role: int) -> None: ...
    def remove_role(self, guild: int, user: Account, role: int) -> None: ...
    def has_role(self, guild: int, user: Account, role: int) -> bool: ...

discord: _Discord

def sha256(text: str) -> str: ...
def random(low: int, high: int) -> int: ...
def min(a: int, b: int) -> int: ...
def max(a: int, b: int) -> int: ...
def abs(a: int) -> int: ...
